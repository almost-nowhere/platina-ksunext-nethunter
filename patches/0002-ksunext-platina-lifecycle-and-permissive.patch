diff --git a/kernel/core/init.c b/kernel/core/init.c
index 97b3c402..58c0ecbf 100644
--- a/kernel/core/init.c
+++ b/kernel/core/init.c
@@ -31,6 +31,25 @@ extern int ksu_handle_execveat_ksud(int *fd, struct filename **filename_ptr,
 int ksu_handle_execveat(int *fd, struct filename **filename_ptr, void *argv,
 			void *envp, int *flags)
 {
+	/*
+	 * The legacy manual-hook path stops its early exec hook after zygote has
+	 * started.  init's later exec services (post-fs-data, services and
+	 * boot-completed) therefore need to be moved into the KSU domain here,
+	 * before SELinux evaluates the explicit u:r:ksu:s0 service seclabel.
+	 *
+	 * Kprobe builds do the equivalent work in
+	 * ksu_handle_init_mark_tracker().  Keep this check in the common manual
+	 * hook so old non-GKI kernels do not fail with a bounded_transition
+	 * denial while executing /data/adb/ksud.
+	 */
+	if (current->pid != 1 && is_init(current_cred()) && filename_ptr &&
+	    !IS_ERR_OR_NULL(*filename_ptr) &&
+	    !strcmp((*filename_ptr)->name, KSUD_PATH)) {
+		pr_info("manual hook: escape init child before executing ksud: %d\n",
+			current->pid);
+		escape_to_root_for_init();
+	}
+
 	ksu_handle_execveat_ksud(fd, filename_ptr, argv, envp, flags);
 	return ksu_handle_execveat_sucompat(fd, filename_ptr, argv, envp,
 					    flags);
