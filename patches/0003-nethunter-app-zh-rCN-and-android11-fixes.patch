@@ -342,6 +342,13 @@ public class CopyBootFilesExecutor {
             if (!pending) return;
             if (!Environment.isExternalStorageManager()) return;
 
+            // A permission dialog can resume the activity after this helper's
+            // one-shot executor has finished. Avoid crashing the app on that
+            // benign second resume; a later normal launch can perform sync.
+            if (executor.isShutdown() || executor.isTerminated()) {
+                return;
+            }
+
             // Clear the flag before starting work to avoid re-entry
             prefs.edit().putBoolean("pending_sd_sync", false).apply();
 
